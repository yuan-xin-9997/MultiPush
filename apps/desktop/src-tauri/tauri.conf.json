{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TurboPushForked",
  "version": "0.0.1",
  "identifier": "top.yuan-xin.turbopushforked",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "TurboPushForked", "width": 1280, "height": 860, "minWidth": 900, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
