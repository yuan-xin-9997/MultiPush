{
  "name": "multipush-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "MultiPush 多平台智能发布系统桌面客户端（Windows / macOS）",
  "author": "yuan.xin",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron . --setup",
    "start": "electron .",
    "check": "node --check main.cjs && node --check setup-preload.cjs && node --check setup.js && node --check scripts/smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --universal --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1"
  }
}
