{
  "name": "multipush-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "MultiPush 多平台智能发布系统本地桌面版（Windows / macOS）",
  "author": "yuan.xin",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "check": "node --check main.cjs && node --check scripts/smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --universal --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  }
}
