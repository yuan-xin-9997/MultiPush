# MultiPush server configuration
# Copy to .env (or /opt/MultiPush/.env) and adjust as needed.
HOST=0.0.0.0
PORT=34080
NODE_ENV=production
DATA_DIR=./data
WEB_DIST=./web/dist

# Recommended in production; when omitted a secret is generated in DATA_DIR/.jwt-secret
# JWT_SECRET=replace-with-a-long-random-string

# Optional absolute base URL used for rendered media links. When omitted the
# request Host header is used (works for LAN access).
# PUBLIC_BASE_URL=http://192.168.0.111:34080

# WeChat uses a separate headless browser. Existing Chrome/Chromium is detected
# automatically; set an absolute executable path if it is installed elsewhere.
# WECHAT_BROWSER_PATH=/usr/bin/chromium


# Douyin creator publishing (Chrome/Chromium detected automatically).
# DOUYIN_BROWSER_PATH=/usr/bin/chromium

# Sspai Matrix publishing (Chrome/Chromium detected automatically).
# SSPAI_BROWSER_PATH=/usr/bin/chromium
#
# Platform rate limits apply to every publishing platform. They are stored in
# the platform_actions table and survive restarts. Names use the platform id:
#   MULTIPUSH_SSPAI_MIN_PUBLISH_INTERVAL_MS=600000
#   MULTIPUSH_SSPAI_DAILY_PUBLISH_LIMIT=5
#   MULTIPUSH_SSPAI_LOGIN_COOLDOWN_MS=120000
#   MULTIPUSH_SSPAI_SESSION_CHECK_COOLDOWN_MS=60000
# The same pattern works for WECHAT, WECHATPIC, ZHIHU, WEIBO, TOUTIAO,
# BAIJIAHAO, DOUBAN, JUEJIN, CSDN, JIANSHU, V2EX, BILIBILI, DOUYIN and BLOG.
# Set an interval or the daily limit to 0 to disable it. The old SSPAI_* names
# are still accepted for compatibility.

# Weibo publishing (Chrome/Chromium detected automatically).
# WEIBO_BROWSER_PATH=/usr/bin/chromium

# Toutiao publishing (Chrome/Chromium detected automatically).
# TOUTIAO_BROWSER_PATH=/usr/bin/chromium
# BAIJIAHAO_BROWSER_PATH=/usr/bin/chromium

# Douban diary publishing (Chrome/Chromium detected automatically).
# DOUBAN_BROWSER_PATH=/usr/bin/chromium

# Juejin / CSDN / Jianshu / V2EX article publishing (Chrome/Chromium detected automatically).
# JUEJIN_BROWSER_PATH=/usr/bin/chromium
# CSDN_BROWSER_PATH=/usr/bin/chromium
# JIANSHU_BROWSER_PATH=/usr/bin/chromium
# V2EX_BROWSER_PATH=/usr/bin/chromium
# V2EX 在中国大陆服务器上通常需要代理；支持 HTTP 代理地址。
# V2EX_PROXY_SERVER=http://192.168.0.100:7890

# Personal Halo blog publishing needs no environment variable: connect from
# 发布管理 → 个人博客 with the blog URL and a Halo personal access token. The
# token is encrypted under DATA_DIR/.blog-session-key.

# AI 创作大模型（OpenAI 兼容）。以下两种方式任选其一。
#
# 方式一（推荐）：多提供商 / 多 Key 高可用池。
# - AI_PROVIDERS_JSON 直接放完整 JSON（适合 CI/密钥管理系统注入）；
# - 或把 JSON 写到 DATA_DIR/ai-providers.json（推荐 chmod 600），
#   也可用 AI_PROVIDERS_FILE 指向其他受保护路径。
# 模板见 server/ai-providers.example.json。优先级：AI_PROVIDERS_JSON >
# AI_PROVIDERS_FILE > DATA_DIR/ai-providers.json > 旧版单 Key 变量。
# AI_PROVIDERS_JSON={"providers":[...],"modelMap":{...}}
# AI_PROVIDERS_FILE=/opt/MultiPush/.data/ai-providers.json
#
# 设置页修改服务器提供商池需要管理员身份。生产环境通过用户名配置（逗号分隔，
# 设为 * 表示所有登录用户）；开发和桌面版默认允许所有登录用户编辑。
# MULTIPUSH_ADMIN_USERNAMES=yuanxin
#
# 方式二（兼容旧部署）：单提供商单 Key，或同提供商多 Key（逗号分隔）。
# 配置 AI_PROVIDERS_JSON / 文件后，以下旧变量不再参与提供商池构建，
# 但仍可作为账号配置“留空 Key”时的默认 Key。
# OPENCODE_GO_API_KEY=oc_sk_xxx
# OPENCODE_GO_API_KEYS=oc_sk_account1,oc_sk_account2
# AI_DEFAULT_BASE_URL=https://opencode.ai/inference/go/openai/v1
# AI_DEFAULT_MODEL=deepseek-v4.1-flash
# AI_DEFAULT_LABEL=OpenCode Go
# 也可使用通用变量：AI_DEFAULT_API_KEY=sk-xxx

# 视频内容剪辑（服务端 ffmpeg / ffprobe）。默认从 PATH 查找；找不到时
# 剪辑时间线仍可保存，导出成片会提示服务器缺少 ffmpeg。
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# 登录与两步验证保护。应用层默认已启用失败计数；可按需调整。
# LOGIN_MAX_FAILURES=8
# LOGIN_IP_MAX_FAILURES=30
# LOGIN_BLOCK_MINUTES=15
# LOGIN_2FA_MAX_FAILURES=8
# 生产环境默认信任本机反向代理（cloudflared/nginx）的 X-Forwarded-For；
# 直接暴露端口时可设为 false。
# TRUST_PROXY=loopback

# 服务器 AI 提供商池的使用范围与额度：
# - admin（生产默认）：仅 is_admin 或 MULTIPUSH_ADMIN_USERNAMES 中的账号可回退到服务器池；
# - all：所有登录账号可回退。非管理员默认每日 0 次表示不限额。
# AI_POOL_ACCESS=admin
# 单独放行若干普通账号（逗号分隔），无需授予管理员；仍受 AI_POOL_DAILY_LIMIT 限制。
# AI_POOL_USERS=username1,username2
# AI_POOL_DAILY_LIMIT=0

# 博客连接、AI 接口和站内图片下载默认禁止访问本机/内网地址（防 SSRF）。
# 仅本地开发或桌面版需要连接局域网服务时设为 1。
# MULTIPUSH_ALLOW_PRIVATE_NETWORK=0
