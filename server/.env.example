# MultiPush server configuration
# Copy to .env (or /opt/MultiPush/.env) and adjust as needed.
HOST=0.0.0.0
PORT=34080
NODE_ENV=production
DATA_DIR=./data
WEB_DIST=./web/dist

# Recommended in production; when omitted a secret is generated in DATA_DIR/.jwt-secret
# JWT_SECRET=replace-with-a-long-random-string

# Optional absolute base URL used for rendered media links. When omitted the
# request Host header is used (works for LAN access).
# PUBLIC_BASE_URL=http://192.168.0.111:34080

# WeChat uses a separate headless browser. Existing Chrome/Chromium is detected
# automatically; set an absolute executable path if it is installed elsewhere.
# WECHAT_BROWSER_PATH=/usr/bin/chromium

# Xiaohongshu reuses detected Chrome/Chromium or WECHAT_BROWSER_PATH.
# XHS_BROWSER_PATH=/usr/bin/chromium

# Douyin creator publishing (Chrome/Chromium detected automatically).
# DOUYIN_BROWSER_PATH=/usr/bin/chromium
