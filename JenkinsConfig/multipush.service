[Unit]
Description=MultiPush Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jenkins
Group=jenkins
WorkingDirectory=/opt/MultiPush/apps/desktop
Environment=PATH=/opt/MultiPush/.runtime/node-v24.13.0-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
Environment=TURBOPUSH_PORT=34080
Environment=TURBOPUSH_DATA_DIR=/opt/MultiPush/.data
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/MultiPush/.browsers
EnvironmentFile=-/opt/MultiPush/.env
ExecStart=/usr/bin/xvfb-run -a /opt/MultiPush/.runtime/node-v24.13.0-linux-x64/bin/node /opt/MultiPush/apps/desktop/node_modules/vite/bin/vite.js preview
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
KillSignal=SIGTERM
UMask=0077

[Install]
WantedBy=multi-user.target
